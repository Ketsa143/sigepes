' Estilo común de los diagramas de SIGEPES (paleta del diseño "Glass over the Nautical Chart").
!pragma layout smetana
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #0B3B5C
skinparam ArrowFontColor #33495A
skinparam ArrowFontSize 11
skinparam TitleFontSize 16
skinparam TitleFontColor #0B3B5C
skinparam ClassBackgroundColor #F2F8FA
skinparam ClassBorderColor #0E7C86
skinparam ClassHeaderBackgroundColor #DCEFF2
skinparam ActorBorderColor #0B3B5C
skinparam ActorBackgroundColor #DCEFF2
skinparam UsecaseBackgroundColor #F2F8FA
skinparam UsecaseBorderColor #0E7C86
skinparam ComponentBackgroundColor #F2F8FA
skinparam ComponentBorderColor #0E7C86
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #0B3B5C
skinparam NodeBackgroundColor #F2F8FA
skinparam NodeBorderColor #0B3B5C
skinparam DatabaseBackgroundColor #DCEFF2
skinparam DatabaseBorderColor #0B3B5C
skinparam ParticipantBackgroundColor #F2F8FA
skinparam ParticipantBorderColor #0E7C86
skinparam SequenceLifeLineBorderColor #8AA4B5
skinparam ActivityBackgroundColor #F2F8FA
skinparam ActivityBorderColor #0E7C86
skinparam ActivityDiamondBackgroundColor #FFF6E0
skinparam ActivityDiamondBorderColor #C98A12
skinparam NoteBackgroundColor #FFF9E6
skinparam NoteBorderColor #C98A12
skinparam ObjectBackgroundColor #F2F8FA
skinparam ObjectBorderColor #0E7C86
